{
  "name": "qinglan-realms",
  "version": "0.27.1",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-equipment-fit-modules.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:client": "vite --host 127.0.0.1",
    "dev:server": "tsx watch server/index.ts",
    "prestart": "node scripts/sync-equipment-fit-modules.mjs",
    "start": "tsx server/index.ts",
    "prebuild": "node scripts/sync-equipment-fit-modules.mjs",
    "build": "tsc --noEmit && vite build",
    "pretest": "node scripts/sync-equipment-fit-modules.mjs",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "verify:babylon": "node scripts/verify-babylon-runtime.mjs",
    "verify:current": "node scripts/verify-current.mjs",
    "verify:package": "node scripts/verify-package-integrity.mjs",
    "verify:fit-garments": "node scripts/verify-all-garment-fit.mjs",
    "verify:editor-import": "node scripts/verify-editor-equipment-import.mjs",
    "verify:equipment-modules": "node scripts/verify-equipment-fit-modules.mjs",
    "check": "npm run verify:babylon && npm run verify:current && npm run verify:package && npm run typecheck && npm run test && npm run build",
    "release:sync": "node scripts/sync-runtime-release.mjs",
    "worker:dry-run": "npx --yes wrangler@4.135.0 deploy --dry-run --config cloudflare/world-worker/wrangler.jsonc",
    "audit:garments": "node scripts/audit-garment-morph-assets.mjs",
    "bake:garment-morphs": "node scripts/bake-garment-morph-assets.mjs",
    "verify:garments": "node scripts/verify-garment-morph-assets.mjs",
    "sync:equipment-modules": "node scripts/sync-equipment-fit-modules.mjs"
  },
  "dependencies": {
    "ws": "^8.18.0",
    "@babylonjs/core": "9.28.0",
    "@babylonjs/loaders": "9.28.0",
    "@babylonjs/materials": "9.28.0"
  },
  "devDependencies": {
    "@types/ws": "^8.18.0",
    "@types/node": "^24.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.3.0",
    "vitest": "^4.0.0",
    "tsx": "^4.21.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "engines": {
    "node": ">=22.12.0 <25"
  }
}
